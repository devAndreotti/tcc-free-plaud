// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BenchmarkPanel sem os campos novos (regressão) > renderiza o mesmo DOM de antes e não cria as seções novas 1`] = `"<header class="page-head"><div><h1>Benchmark</h1><p>O mesmo conjunto de perguntas contra as três estratégias de busca.</p></div><div class="page-head__actions"><button type="button" class="btn btn--primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>Rodar comparação</button></div></header><div class="page-scroll"><section class="card queue__source" aria-label="Suite"><label class="queue__field"><span>suite.json</span><input id="benchmark-suite-path" class="mono" placeholder="data/datasets/suite.json" value="suite.json"></label><button type="button" class="btn"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>Selecionar suite</button></section><p class="queue__status" role="status">Comparação cmp-legacy concluída.</p><div class="bench__snap" aria-label="Configuração usada"><span><em>modelo de busca semântica</em>fake-hash</span><span><em>device</em>cpu</span><span><em>top_k</em>4</span><span><em>trecho</em>800 / 120</span><span><em>resposta</em>extractive</span><span class="bench__id"><b>cmp-legacy</b> · suite-legacy</span></div><p class="bench__thesis">A híbrida traz a fonte certa entre os 5 primeiros trechos em 100% das perguntas, 25 pontos acima da lexical, e custa 3 ms a mais por consulta.</p><div class="bench__grid"><section class="card"><div class="card__head"><h2>Resultado por estratégia</h2><span class="card__count">4 perguntas</span></div><div class="bench__scope"><div class="notes__filters" role="group" aria-label="Escopo da busca"><button type="button" class="notes__chip" aria-pressed="true">Corpus inteiro</button><button type="button" class="notes__chip" aria-pressed="false">Por documento</button></div><p>As 2 notas da suite num corpus só, buscadas como o chat busca; um trecho certo de outra nota conta como erro.</p></div><div class="bench__table-wrap"><table class="data-table"><thead><tr><th>Estratégia</th><th class="num">MRR</th><th class="num">Recall@3</th><th class="num">Recall@5</th><th class="num">Recall@10</th><th class="num">nDCG@10</th><th class="num">Latência p50</th></tr></thead><tbody><tr><td><b>Lexical</b><span class="bench__sub mono">busca por palavras</span></td><td class="num">0,750<span class="bench__ci" title="Intervalo de confiança de 95% (bootstrap)">0,50–1,00</span></td><td class="num">0,750</td><td class="num">0,750</td><td class="num">0,750</td><td class="num"><span class="bench__best">0,000</span></td><td class="num"><span class="bench__best">3 ms</span><span class="bench__ci">p95 5 ms</span></td></tr><tr><td><b>Híbrida</b><span class="bench__sub mono">RRF</span></td><td class="num"><span class="bench__best">0,900</span><span class="bench__ci" title="Intervalo de confiança de 95% (bootstrap)">0,70–1,00</span></td><td class="num"><span class="bench__best">1,000</span></td><td class="num"><span class="bench__best">1,000</span></td><td class="num"><span class="bench__best">1,000</span></td><td class="num"><span class="bench__best">0,000</span></td><td class="num">6 ms<span class="bench__ci">p95 8 ms</span></td></tr></tbody></table></div><p class="bench__caption">Maior é melhor em MRR, Recall e nDCG; menor é melhor em latência. Destaque = melhor da coluna. A faixa sob o MRR é o intervalo de confiança de 95%: faixas que se sobrepõem não separam as estratégias.</p></section><section class="card"><div class="card__head"><h2>Recall@k</h2><span class="card__count">fração das perguntas</span></div><div class="bench__chart"><div class="bench__chart-legend"><span><i style="background: var(--series-1);"></i>k = 3</span><span><i style="background: var(--series-2);"></i>k = 5</span><span><i style="background: var(--series-3);"></i>k = 10</span></div><svg viewBox="0 0 460 250" role="img" aria-label="Recall@3, @5 e @10 por estratégia: Lexical 75% em k=10; Híbrida 100% em k=10"><g><line x1="40" x2="452" y1="206" y2="206" style="stroke: var(--border-color);"></line><text x="32" y="209.5" text-anchor="end" class="bench__axis">0</text></g><g><line x1="40" x2="452" y1="158.5" y2="158.5" style="stroke: var(--border-color-subtle);"></line><text x="32" y="162" text-anchor="end" class="bench__axis">0,25</text></g><g><line x1="40" x2="452" y1="111" y2="111" style="stroke: var(--border-color-subtle);"></line><text x="32" y="114.5" text-anchor="end" class="bench__axis">0,5</text></g><g><line x1="40" x2="452" y1="63.5" y2="63.5" style="stroke: var(--border-color-subtle);"></line><text x="32" y="67" text-anchor="end" class="bench__axis">0,75</text></g><g><line x1="40" x2="452" y1="16" y2="16" style="stroke: var(--border-color-subtle);"></line><text x="32" y="19.5" text-anchor="end" class="bench__axis">1</text></g><g><g><rect x="101" y="63.5" width="24" height="142.5" rx="3" style="fill: var(--series-1);"><title>Lexical · Recall@3 0,750</title></rect></g><g><rect x="131" y="63.5" width="24" height="142.5" rx="3" style="fill: var(--series-2);"><title>Lexical · Recall@5 0,750</title></rect></g><g><rect x="161" y="63.5" width="24" height="142.5" rx="3" style="fill: var(--series-3);"><title>Lexical · Recall@10 0,750</title></rect><text x="173" y="57.5" text-anchor="middle" class="bench__value">0,750</text></g><text x="143" y="230" text-anchor="middle" class="bench__group">Lexical</text></g><g><g><rect x="307" y="16" width="24" height="190" rx="3" style="fill: var(--series-1);"><title>Híbrida · Recall@3 1,000</title></rect></g><g><rect x="337" y="16" width="24" height="190" rx="3" style="fill: var(--series-2);"><title>Híbrida · Recall@5 1,000</title></rect></g><g><rect x="367" y="16" width="24" height="190" rx="3" style="fill: var(--series-3);"><title>Híbrida · Recall@10 1,000</title></rect><text x="379" y="10" text-anchor="middle" class="bench__value">1,000</text></g><text x="349" y="230" text-anchor="middle" class="bench__group">Híbrida</text></g></svg></div></section></div><section class="card" aria-label="Responder ou se abster"><div class="card__head"><h2>Responder ou se abster</h2><span class="card__count">4 com resposta · 2 sem resposta</span></div><p class="bench__abstain-lead">Na híbrida, 1 de 2 perguntas sem resposta no corpus recebem uma resposta mesmo assim, e 0% das que têm resposta ficam sem ela.</p><div class="bench__table-wrap"><table class="data-table"><thead><tr><th>Estratégia</th><th class="num">Responde quando há resposta</th><th class="num">Se abstém quando não há</th><th class="num">Decisão certa</th></tr></thead><tbody><tr><td><b>Lexical</b></td><td class="num">75%</td><td class="num">0%</td><td class="num">50%</td></tr><tr><td><b>Híbrida</b></td><td class="num">100%</td><td class="num">50%</td><td class="num">75%</td></tr></tbody></table></div><p class="bench__caption">Resposta extrativa, sem modelo gerativo, com o top-k do chat. As perguntas sem resposta vêm do dataset de negativas da suite.</p></section><section class="card" aria-label="Relatórios"><div class="card__head"><h2>Relatórios desta comparação</h2></div><div class="bench__report"><span class="bench__fmt mono">JSON</span><code>data/results/cmp-legacy.json</code><button type="button" class="btn-icon" aria-label="Copiar caminho do JSON"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button></div><div class="bench__report"><span class="bench__fmt mono">CSV</span><code>data/results/cmp-legacy.csv</code><button type="button" class="btn-icon" aria-label="Copiar caminho do CSV"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button></div></section></div>"`;
