Screen {
    background: #0f0718;
    color: #f7efff;
}

Header {
    background: #180d26;
    color: #f7efff;
    text-style: bold;
}

Footer {
    background: #0f0718;
    color: #bda8cf;
    border-top: solid #372150;
}

#content {
    height: 1fr;
}

#nav-panel {
    width: 28;
    height: 1fr;
    background: #180d26;
    border-right: solid #372150;
    padding: 1 1;
}

#nav-brand {
    color: #f7efff;
    text-style: bold;
    padding: 0 1;
}

#nav-subtitle {
    color: #bda8cf;
    padding: 0 1 1 1;
}

#nav-actions {
    height: 1fr;
    margin-top: 1;
}

Button.nav-button {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    background: #180d26;
    color: #bda8cf;
    border: none;
    text-align: left;
}

Button.nav-button:hover {
    background: #211033;
    color: #f7efff;
}

Button.nav-button:focus {
    background: #211033;
    color: #f7efff;
    border-left: solid #f04ddf;
}

Button.nav-active {
    background: #7c3aed 35%;
    color: #f7efff;
    border-left: solid #f04ddf;
    text-style: bold;
}

Button.nav-planned {
    color: #8f7aa3;
}

#nav-meta {
    height: auto;
    border: solid #372150;
    background: #0f0718;
    padding: 1;
}

.nav-meta-label {
    color: #8f7aa3;
}

.nav-meta-value {
    color: #f7efff;
    text-style: bold;
    margin-bottom: 1;
}

#main-panel {
    width: 1fr;
    height: 1fr;
    background: #0f0718;
    padding: 1 2;
}

.screen-pane {
    height: 1fr;
}

#ask-hero {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
}

.hero-title {
    color: #f7efff;
    text-style: bold;
}

.hero-subtitle {
    color: #bda8cf;
}

#ask-form-card {
    height: 15;
    background: #180d26;
    border: solid #372150;
    padding: 1 2;
    margin-bottom: 0;
}

#ask-result-card {
    height: 1fr;
    background: #180d26;
    border: solid #372150;
    padding: 1 2;
}

.placeholder-card {
    background: #180d26;
    border: solid #372150;
    padding: 2;
}

.card-title {
    color: #f04ddf;
    text-style: bold;
    margin-bottom: 0;
}

Label {
    color: #bda8cf;
    margin-top: 0;
}

Input {
    border: solid #372150;
    background: #211033;
    color: #f7efff;
}

Input:focus {
    border: solid #f04ddf;
}

#strategy-row {
    height: 3;
}

Button.strategy-button {
    width: 8;
    min-width: 8;
    max-width: 8;
    height: 3;
    margin-right: 1;
    background: #211033;
    color: #bda8cf;
    border: solid #372150;
}

Button.strategy-button:hover {
    background: #2a1740;
    color: #f7efff;
}

Button.strategy-button:focus {
    border: solid #f04ddf;
    color: #f7efff;
}

Button.strategy-active {
    background: #7c3aed 45%;
    color: #f7efff;
    border: solid #f04ddf;
    text-style: bold;
}

Button.primary-action {
    width: 17;
    min-width: 17;
    max-width: 17;
    height: 3;
    margin-top: 0;
    background: #f04ddf 30%;
    color: #f7efff;
    border: solid #f04ddf;
    text-style: bold;
}

Button.primary-action:hover {
    background: #f04ddf 45%;
}

Button.primary-action:focus {
    border: tall #f7efff;
}

Button:disabled {
    background: #211033;
    color: #8f7aa3;
    border: solid #372150;
}

RichLog {
    height: 1fr;
    background: #0f0718;
    color: #f7efff;
    border: none;
}

.hidden {
    display: none;
}
