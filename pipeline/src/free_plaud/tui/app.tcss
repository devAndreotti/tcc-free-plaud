Screen {
    background: #0b0712;
    color: #f8f0ff;
}

Header {
    background: #160b22;
    color: #f8f0ff;
    text-style: bold;
}

Footer {
    background: #0b0712;
    color: #bda8cf;
    border-top: solid #332043;
}

#content {
    layout: horizontal;
    height: 1fr;
}

#nav-panel {
    width: 26;
    height: 1fr;
    background: #12091c;
    border-right: solid #332043;
    padding: 1 1;
}

#nav-brand {
    color: #f8f0ff;
    text-style: bold;
    padding: 0 1;
}

#nav-subtitle {
    color: #bda8cf;
    padding: 0 1 1 1;
}

#nav-actions {
    height: 1fr;
    margin-top: 1;
}

Button.nav-button {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    background: #12091c;
    color: #bda8cf;
    border: none;
    content-align: left middle;
}

Button.nav-button:hover {
    background: #21142f;
    color: #f8f0ff;
}

Button.nav-button:focus {
    background: #21142f;
    color: #f8f0ff;
    border-left: solid #e84fe6;
}

Button.nav-active {
    background: #7c3aed 28%;
    color: #f8f0ff;
    border-left: solid #e84fe6;
    text-style: bold;
}

Button.nav-planned {
    color: #8f7aa3;
}

#nav-meta {
    height: auto;
    border: solid #332043;
    background: #0b0712;
    padding: 1;
}

.nav-meta-label {
    color: #8f7aa3;
}

.nav-meta-value {
    color: #f8f0ff;
    text-style: bold;
    margin-bottom: 1;
}

#main-panel {
    width: 1fr;
    height: 1fr;
    background: #0b0712;
    padding: 1 2;
}

.screen-pane {
    height: 1fr;
}

#ask-hero {
    height: 2;
    padding: 0 1;
    margin-bottom: 1;
}

.hero-title {
    color: #f8f0ff;
    text-style: bold;
}

.hero-subtitle {
    color: #bda8cf;
}

#ask-form-card {
    height: auto;
    min-height: 16;
    background: #160b22;
    border: solid #332043;
    padding: 1 2;
    margin-bottom: 1;
}

#ask-result-card {
    height: 1fr;
    background: #160b22;
    border: solid #332043;
    padding: 1 2;
}

.placeholder-card {
    background: #160b22;
    border: solid #332043;
    padding: 2;
}

.card-title {
    color: #e84fe6;
    text-style: bold;
    margin-bottom: 0;
}

Label {
    color: #bda8cf;
    margin-top: 0;
}

Input {
    border: solid #332043;
    background: #21142f;
    color: #f8f0ff;
}

Input:focus {
    border: solid #e84fe6;
}

#strategy-row {
    layout: grid;
    grid-size: 4 1;
    grid-gutter: 1 0;
    height: 3;
    margin-top: 0;
}

Button.strategy-button {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 3;
    margin-right: 0;
    background: #21142f;
    color: #bda8cf;
    border: solid #332043;
    content-align: center middle;
}

Button.strategy-button:hover {
    background: #2b1a3d;
    color: #f8f0ff;
}

Button.strategy-button:focus {
    border: solid #e84fe6;
    color: #f8f0ff;
}

Button.strategy-active {
    background: #7c3aed 35%;
    color: #f8f0ff;
    border: solid #e84fe6;
    text-style: bold;
}

Button.primary-action {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 3;
    margin-top: 0;
    background: #e84fe6 26%;
    color: #f8f0ff;
    border: solid #e84fe6;
    text-style: bold;
    content-align: center middle;
}

Button.primary-action:hover {
    background: #e84fe6 42%;
}

Button.primary-action:focus {
    border: tall #f8f0ff;
}

Button:disabled {
    background: #21142f;
    color: #8f7aa3;
    border: solid #332043;
}

RichLog {
    height: 1fr;
    background: #160b22;
    color: #f8f0ff;
    border: none;
}

.hidden {
    display: none;
}

Screen.compact #nav-panel {
    width: 18;
}

Screen.compact #nav-subtitle {
    display: none;
}

Screen.compact #nav-meta {
    display: none;
}

Screen.compact #main-panel {
    padding: 1;
}

Screen.compact #ask-hero {
    height: 1;
    margin-bottom: 0;
}

Screen.compact .hero-subtitle {
    display: none;
}

Screen.compact #ask-form-card {
    min-height: 14;
    margin-bottom: 0;
    padding: 1;
}

Screen.compact Input {
    height: 1;
    border: none;
    padding: 0 1;
}

Screen.compact Input:focus {
    border: none;
    background: #2b1a3d;
}

Screen.compact #ask-form-card .card-title {
    display: none;
}

Screen.compact #strategy-label {
    display: none;
}

Screen.compact #strategy-row {
    grid-size: 2 2;
    grid-gutter: 0;
    height: 6;
}
