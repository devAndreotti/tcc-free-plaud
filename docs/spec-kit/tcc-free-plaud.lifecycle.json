    { "id": "retry-proc", "from": "failed", "to": "processing", "variant": "emphasis", "fromSide": "left", "toSide": "top", "via": [[20, 385], [20, 80], [248, 80]] },
    { "id": "audit-rejected", "from": "insufficient", "to": "rejected", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Dual Index Lifecycle",
      "items": [
        "Ingestion pipelines stream audio to Whisper and text to normalizer",
        "Both FTS5 and ChromaDB are updated atomically before becoming searchable",
        "CorpusRuntime keeps in-memory state fresh without cold restarts"
      ]
    },
    {
      "dot": "amber",
      "title": "Sparse Corpus Guardrail",
      "items": [
        "If RRF produces no hits above the confidence threshold, query routes to Sparse Corpus",
        "System signals corpus limitation rather than generating ungrounded assumptions"
      ]
    },
    {
      "dot": "rose",
      "title": "Deterministic Rejection",
      "items": [
        "If LLM generates citations not matching source document spans, response is flagged",
        "Failed extractions trigger clean retry without polluting the index"
      ]
    }
  ]
