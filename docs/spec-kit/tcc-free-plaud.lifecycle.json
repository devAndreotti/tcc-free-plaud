  "states": [
    { "id": "queued", "type": "start", "label": "Intake", "sublabel": "audio/doc queued", "lane": "main", "col": 0, "step": "01", "tag": "entry" },
    { "id": "processing", "type": "active", "label": "Processing", "sublabel": "STT & chunking", "lane": "main", "col": 1, "step": "02", "tag": "worker" },
    { "id": "indexed", "type": "active", "label": "Indexed", "sublabel": "FTS5 + ChromaDB", "lane": "main", "col": 2, "step": "03", "tag": "storage" },
    { "id": "evaluating", "type": "decision", "label": "Retrieving", "sublabel": "RRF hybrid fusion", "lane": "main", "col": 3, "step": "04", "tag": "rag" },
    { "id": "grounded", "type": "success", "label": "Synthesized", "sublabel": "verified answer", "lane": "main", "col": 4, "step": "05", "tag": "done" },
    { "id": "insufficient", "type": "waiting", "label": "Sparse Corpus", "sublabel": "no relevant spans", "lane": "waiting", "col": 1, "tag": "fallback" },
